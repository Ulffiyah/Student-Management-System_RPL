<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Section: Perpustakaan Terdekat -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Perpustakaan Terdekat"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Perpustakaan 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLib1"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@color/gray_light"
                            android:src="@drawable/images__1__removebg_preview"
                            app:tint="@color/primary_dark"
                            android:scaleType="centerInside" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perpustakaan SMAN 1 Lasalimu"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.2 km dari lokasi Anda"
                                android:textSize="12sp"
                                android:textColor="@color/primary_dark"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jln. Poros Kamaru-baubau"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text" />

                            <Button
                                android:id="@+id/btnLocation1"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_gravity="end"
                                android:layout_marginTop="4dp"
                                android:backgroundTint="@color/primary_dark"
                                android:text="Lihat Lokasi"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:paddingHorizontal="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Perpustakaan 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLib2"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@color/gray_light"
                            android:src="@drawable/gambar_ps_1_removebg_preview"
                            app:tint="@color/primary_dark"
                            android:scaleType="centerInside" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perpustakaan Nasional"
                                android:textSize="16sp"
                                android:textStyle="bold"                                 android:textColor="@color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2.5 km dari lokasi Anda"
                                android:textSize="12sp"
                                android:textColor="@color/primary_dark"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pusat Kota Baubau"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text" />

                            <Button
                                android:id="@+id/btnLocation2"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_gravity="end"
                                android:layout_marginTop="4dp"
                                android:backgroundTint="@color/primary_dark"
                                android:text="Lihat Lokasi"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:paddingHorizontal="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Perpustakaan 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLib3"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@color/gray_light"
                            android:src="@drawable/perpustakaan"
                            app:tint="@color/primary_dark"
                            android:scaleType="centerInside" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perpustakaan Desa Sukamaju"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.8 km dari lokasi Anda"
                                android:textSize="12sp"
                                android:textColor="@color/primary_dark"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kecamatan Sukamaju"
                                android:textSize="11sp"
                                android:textColor="@color/gray_text" />

                            <Button
                                android:id="@+id/btnLocation3"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_gravity="end"
                                android:layout_marginTop="4dp"
                                android:backgroundTint="@color/primary_dark"
                                android:text="Lihat Lokasi"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:paddingHorizontal="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Section: Rekomendasi Buku -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Rekomendasi Buku"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Buku 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBookHome1"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="110dp"
                            android:background="@color/gray_light"
                            android:src="@drawable/why_we_sleep"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Why We Sleep"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Matthew Walker"
                                android:textSize="12sp"
                                android:textColor="@color/gray_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rating: 4.9/5"
                                android:textSize="12sp"
                                android:textColor="@color/primary_dark"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp">
                                
                                <Button
                                    android:id="@+id/btnKeRakBuku"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:backgroundTint="#EDEDED"
                                    android:text="Ke Rak Buku"
                                    android:textColor="@color/black"
                                    android:textSize="10sp"
                                    android:paddingHorizontal="12dp"/>

                                <Button
                                    android:id="@+id/btnDetailHome"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_alignParentEnd="true"
                                    android:backgroundTint="@color/primary_dark"
                                    android:text="Detail"
                                    android:textColor="@color/white"
                                    android:textSize="10sp"
                                    android:paddingHorizontal="12dp"/>
                            </RelativeLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>